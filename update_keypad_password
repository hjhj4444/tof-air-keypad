import json
import boto3
from datetime import datetime


dynamodb = boto3.resource('dynamodb')
password_table = dynamodb.Table('keypad_password')
history_table = dynamodb.Table('password_history')


def lambda_handler(event, context):
    if 'body' in event:
        body = json.loads(event['body'])
    else:
        body = event


    device_id = body['device_id']
    current_password = body['current_password']
    new_password = body['new_password']


    response = password_table.get_item(
        Key={
            'device_id': device_id
        }
    )


    item = response.get('Item')


    if not item:
        return {
            'statusCode': 404,
            'body': json.dumps({
                'message': 'Device not found'
            })
        }


    saved_password = item['password']


    if saved_password != current_password:
        return {
            'statusCode': 400,
            'body': json.dumps({
                'message': 'Current password is incorrect'
            })
        }


    now = datetime.now().isoformat()


    history_table.put_item(
        Item={
            'device_id': device_id,
            'changed_at': now,
            'old_password': saved_password,
            'new_password': new_password
        }
    )


    password_table.put_item(
        Item={
            'device_id': device_id,
            'password': new_password,
            'updated_at': now
        }
    )


    return {
        'statusCode': 200,
        'body': json.dumps({
            'message': 'Password updated successfully'
        })
    }
